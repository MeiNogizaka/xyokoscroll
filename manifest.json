{
  "manifest_version": 3,
  "name": "xyokoscroll",
  "description": "__MSG_extDescription__",
  "version": "0.3.0",
  "default_locale": "en",
  "permissions": ["storage"],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["carousel.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
